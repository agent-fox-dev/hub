ARG BUILDER=registry.redhat.io/ubi10/go-toolset:latest
ARG RUNTIME=registry.access.redhat.com/ubi10/ubi-minimal:latest

# ---------- build ----------
FROM ${BUILDER} AS build

ARG VERSION=dev
ARG BUILD=dev
ARG BUILD_TIME=

USER root
WORKDIR /build

# go-duckdb (used by internal/audit) requires cgo and links against libstdc++.
RUN dnf install -y --setopt=tsflags=nodocs gcc gcc-c++ && \
    dnf -y clean all --enablerepo='*' && \
    rm -rf /var/cache/dnf

# Local replace github.com/txsvc/apikit => ../apikit (see go.mod).
# Supply the sibling tree via: podman build --build-context apikit=../apikit
COPY --from=apikit . /build/apikit
WORKDIR /build/hub
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 go build \
    -ldflags "-s -w \
      -X github.com/txsvc/apikit.Version=${VERSION} \
      -X github.com/txsvc/apikit.Commit=${BUILD} \
      -X github.com/txsvc/apikit.BuildTime=${BUILD_TIME} \
      -X github.com/txsvc/apikit/internal/cli.Version=${VERSION} \
      -X github.com/txsvc/apikit/internal/cli.Build=${BUILD} \
      -X github.com/txsvc/apikit.TokenPrefix=af \
      -X github.com/txsvc/apikit/internal/cli.TokenPrefix=af" \
    -o hub ./cmd/af-hub

RUN CGO_ENABLED=1 go build \
    -ldflags "-s -w \
      -X github.com/txsvc/apikit.Version=${VERSION} \
      -X github.com/txsvc/apikit.Commit=${BUILD} \
      -X github.com/txsvc/apikit.BuildTime=${BUILD_TIME} \
      -X github.com/txsvc/apikit/internal/cli.Version=${VERSION} \
      -X github.com/txsvc/apikit/internal/cli.Build=${BUILD} \
      -X github.com/txsvc/apikit.TokenPrefix=af \
      -X github.com/txsvc/apikit/internal/cli.TokenPrefix=af" \
    -o afc ./cmd/afc

# ---------- runtime ----------
FROM ${RUNTIME}

# ubi-micro has no package manager and thus no way to provide libstdc++,
# which the cgo-enabled go-duckdb dependency needs at runtime. ubi-minimal
# gives us microdnf to install just that shared library.
RUN microdnf install -y --setopt=install_weak_deps=0 libstdc++ && \
    microdnf clean all

ENV XDG_CONFIG_HOME=/config
ENV XDG_DATA_HOME=/data

EXPOSE 80
EXPOSE 8080

# CA certificates for outbound TLS
COPY --from=build /etc/pki/tls/certs/ca-bundle.crt /etc/pki/tls/certs/ca-bundle.crt

RUN mkdir -p /config/af-hub /data/af-hub

# copy a default config (override at runtime by mounting /config/af-hub/config.toml)
COPY containers/hub/config.toml /config/af-hub/config.toml

# copy the run script
COPY containers/hub/run /usr/local/bin/run

# copy the binaries
COPY --from=build /build/hub/hub /usr/bin/hub
COPY --from=build /build/hub/afc /usr/bin/afc

RUN chmod +x /usr/local/bin/run /usr/bin/hub
RUN chmod +x /usr/local/bin/run /usr/bin/afc

VOLUME /config
VOLUME /data

CMD ["/usr/local/bin/run"]
