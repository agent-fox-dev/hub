#https://catalog.redhat.com/en/software/containers/rhel10/s2i-core/677cf8035fdd0fab2f79e70a#overview
FROM quay.io/agentfox/sandbox:latest

USER root

ARG TARGETARCH

ENV ARCH=${TARGETARCH:-arm64} \
    APP_ROOT=/opt/app-root \
    HOME=/opt/app-root/src \
    WORKSPACE=/opt/app-root/workspace \
    XDG_CONFIG_HOME=${APP_ROOT}/.config \
    PATH=${HOME}/.local/bin:${PATH}

# set the virtual environment
ENV UV_PYTHON=python3.14 VIRTUAL_ENV=/venv

# install python dependencies
COPY containers/agents/requirements.txt /tmp/requirements.txt

RUN uv venv --clear /venv && \
    uv pip install -r /tmp/requirements.txt && \
    rm -rf /tmp/requirements.txt

# install pi, opencode, claude code

# install pi agent
RUN curl -fsSL https://pi.dev/install.sh | sh

# install opencode agent
# note: unset VERSION first -- it's set to the RHEL major version (e.g. "10")
# by the s2i-core base image, and opencode's installer misreads it as a
# requested opencode release version (VERSION=10 -> "Release v10 not found").
ENV PATH=${HOME}/.opencode/bin:${PATH}
RUN curl -fsSL https://opencode.ai/install | env -u VERSION bash

# install claude code agent
RUN curl -fsSL https://claude.ai/install.sh | bash

# clean up
RUN dnf -y clean all --enablerepo='*' && \
    rm -rf /var/cache/dnf

# Reset permissions of modified directories
RUN rpm-file-permissions && chown -R 1001:0 ${APP_ROOT}

USER 1001

# Directory with the sources is set as the working directory so all STI scripts
# can execute relative to this path.
WORKDIR ${WORKSPACE}